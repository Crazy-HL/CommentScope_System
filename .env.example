# Copy to .env and replace both placeholders before starting.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
ADMIN_SESSION_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ADMIN_COOKIE_SECURE=0
# Optional separate API token; omit to disable token access.
# RESEARCHER_ADMIN_TOKEN=REPLACE_WITH_AN_INDEPENDENT_RANDOM_TOKEN
EXPERIMENT_DB_PATH=data/experiment.sqlite3
PORT=8888
CLIENT_DIST_PATH=client/dist
